# Copy to .env and fill in. .env is gitignored; never commit real keys.

# NVIDIA API Catalog key (build.nvidia.com), reserved for a hosted
# kumo-relational backtest. Nothing reads it yet. Starts with "nvapi-".
NVIDIA_API_KEY=

# Hugging Face (huggingface.co/settings/tokens, "write" scope) and the private
# dataset repo that holds data/. With both set, the container pulls any
# missing data files on start; upload with: python -m mlb_hr.hf_data push
HF_TOKEN=
HF_DATA_REPO=

# Existing app knobs (defaults shown).
SLATE_TTL_MINUTES=45
RESULTS_TTL_SECONDS=45
